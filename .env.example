# Django
DJANGO_SETTINGS_MODULE=core.settings.development
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://campaignmanager:campaignmanager@localhost:5432/campaignmanager

# Redis (cache)
REDIS_URL=redis://localhost:6379/1

# Email (SMTP)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@campaignmanager.local

# CORS
CORS_ORIGIN_ALLOW_ALL=True

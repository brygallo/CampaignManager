# Django
DJANGO_SETTINGS_MODULE=core.settings.development
# Required, no default. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://campaignmanager:campaignmanager@localhost:5432/campaignmanager

# Redis (cache)
REDIS_URL=redis://localhost:6379/1

# Email (SMTP)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@campaignmanager.local

# CORS — leave commented in production; whitelist explicitly via CORS_ALLOWED_ORIGINS.
# CORS_ORIGIN_ALLOW_ALL=False
# CORS_ALLOWED_ORIGINS=https://app.tudominio.com

# MinIO / S3 (media backend for tenant uploads)
# In production, point AWS_* at the real S3/MinIO cluster and remove
# MINIO_ROOT_* (those only seed the local docker-compose MinIO server).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=campaignmanager-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_PUBLIC_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_QUERYSTRING_AUTH=False
AWS_DEFAULT_ACL=

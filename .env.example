# Django
DJANGO_SETTINGS_MODULE=core.settings.development
# Required, no default. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://campaignmanager:campaignmanager@localhost:5432/campaignmanager

# Redis (cache)
REDIS_URL=redis://localhost:6379/1

# Email (SMTP)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@campaignmanager.local

# CORS — leave commented in production; whitelist explicitly via CORS_ALLOWED_ORIGINS.
# CORS_ORIGIN_ALLOW_ALL=False
# CORS_ALLOWED_ORIGINS=https://app.tudominio.com
